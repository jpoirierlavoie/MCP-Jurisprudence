{
  "name": "mcp-jurisprudence",
  "version": "0.3.0",
  "private": true,
  "description": "Serveur MCP « MCP Jurisprudence » — vérification déterministe de jurisprudence canadienne (collection CanLII). Worker Cloudflare, lecture seule.",
  "license": "CC-BY-NC-SA-4.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "deploy": "node scripts/deployer.mjs",
    "cf-typegen": "wrangler types",
    "type-check": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply canlii --local",
    "db:migrate:remote": "wrangler d1 migrations apply canlii --remote"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@poirierlavoie/socle-juridique": "github:jpoirierlavoie/MCP-Socle-Juridique#v0.6.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.162.0"
  },
  "overrides": {
    "sharp": "^0.35.5",
    "undici": "^7.30.2",
    "zod": "^4.6.7"
  }
}
